# ─────────────────────────────────────────────────────────────────────────────
# Race Node.js 后端配置文件
# 复制此文件为 .env 并填入真实配置
# ─────────────────────────────────────────────────────────────────────────────

# 服务器端口
PORT=8080

# JWT 密钥与过期时间（单位：秒）
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7200

# SQLite 数据库文件路径（相对于 node-server 目录）
DB_PATH=./data/race.db

# ─── 百度千帆 API（AI 对话） ──────────────────────────────────────────────────
# 在 https://console.bce.baidu.com/qianfan 获取
BAIDU_QIANFAN_API_KEY=your_baidu_api_key
BAIDU_QIANFAN_SECRET_KEY=your_baidu_secret_key
# 使用的模型名称，默认 ernie-speed-128k
BAIDU_CHAT_MODEL=ernie-speed-128k

# ─── 百度 AI 作画（文生图） ───────────────────────────────────────────────────
# 同上，复用千帆的 AK/SK 即可
# 文生图接口使用 ERNIE-ViLG 2.0（稳定版）
BAIDU_PICTURE_API_KEY=your_baidu_api_key
BAIDU_PICTURE_SECRET_KEY=your_baidu_secret_key

# ─── 百度地图 JavaScript API Key ─────────────────────────────────────────────
# 在 https://lbsyun.baidu.com 控制台获取
BAIDU_MAP_AK=your_baidu_map_ak

# ─── 前端跨域允许来源 ─────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
