{
  "name": "race-server",
  "version": "1.0.0",
  "description": "Race AI Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "pkg . --targets node18-win-x64 --output race-server.exe"
  },
  "pkg": {
    "assets": [
      "node_modules/better-sqlite3/build/**/*",
      ".env"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "."
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}